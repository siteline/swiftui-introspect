#!/usr/bin/env bash
#MISE description="Run the benchmarks, and compare them with a base revision when one is given"
#USAGE arg "[base]" help="Git revision to compare the working copy against, benchmarked in a temporary export"
#USAGE flag "--destination <destination>" default="platform=iOS Simulator,name=iPhone 17 Pro" help="xcodebuild destination for every run"
#USAGE flag "--output <directory>" help="Directory for the result bundles and exported metrics, a temporary one by default"
#USAGE flag "--flag-percent <percent>" default="30" help="Mark increases above this percentage"
#
# Prints a Markdown table of each benchmark's median, using instructions retired
# when every run reports them, and CPU time otherwise, since virtualized runners
# such as GitHub's don't expose hardware counters. xcodebuild output goes to stderr.
set -euo pipefail

output=${usage_output:-$(mktemp -d)}
mkdir -p "$output"

instructions="com.apple.dt.XCTMetric_CPU.instructions_retired"
cpu_time="com.apple.dt.XCTMetric_CPU.time"

# Runs the benchmarks of a checkout and exports their metrics, or an empty list when it has no benchmarks.
benchmark() { # checkout name
	if ! xcodebuild -list -project "$1/Tests/Tests.xcodeproj" 2> /dev/null | grep -q SwiftUIIntrospectBenchmarks; then
		echo "[]" > "$output/$2.json"
		return
	fi
	rm -rf "$output/$2.xcresult"
	xcodebuild test \
		-workspace "$1/SwiftUIIntrospect.xcworkspace" \
		-scheme SwiftUIIntrospectBenchmarks \
		-destination "$usage_destination" \
		-resultBundlePath "$output/$2.xcresult" >&2
	xcrun xcresulttool get test-results metrics --path "$output/$2.xcresult" > "$output/$2.json"
}

medians() { # file metric
	jq --arg metric "$2" '
		map({
			key: (.testIdentifier | sub("\\(\\)$"; "")),
			value: (.testRuns[0].metrics[] | select(.identifier == $metric) | .measurements | sort | .[length / 2 | floor]),
		})
		| from_entries
	' "$1"
}

has_counts() { # file
	jq -e --arg metric "$instructions" '
		length == 0 or any(.[].testRuns[0].metrics[]; .identifier == $metric and (.measurements | max) > 0)
	' "$1" > /dev/null
}

if [ -n "${usage_base:-}" ]; then
	base_checkout=$(mktemp -d)
	trap 'rm -rf "$base_checkout"' EXIT
	git archive "$usage_base" | tar -x -C "$base_checkout"
	benchmark "$base_checkout" base
else
	echo "[]" > "$output/base.json"
fi
benchmark . head

if has_counts "$output/base.json" && has_counts "$output/head.json"; then
	metric=$instructions
else
	metric=$cpu_time
fi

jq -n -r \
	--argjson base "$(medians "$output/base.json" "$metric")" \
	--argjson head "$(medians "$output/head.json" "$metric")" \
	--argjson flag "$usage_flag_percent" \
	--arg metric "$metric" \
	--arg instructions "$instructions" '
	def value:
		if $metric == $instructions then . / 1000 | . * 10 | round / 10 | tostring + "M"
		else . * 1000 | round | tostring + " ms"
		end;
	def change: (if . > 0 then "+" else "" end) + (. * 10 | round / 10 | tostring) + "%";
	"| Benchmark | Base | Head | Change |",
	"| --- | ---: | ---: | ---: |",
	(
		$head | keys[] as $name
		| $head[$name] as $new
		| $base[$name] as $old
		| if $old == null then
			"| \($name) | | \($new | value) | New |"
		else
			(($new - $old) / $old * 100) as $delta
			| "| \($name) | \($old | value) | \($new | value) | \($delta | change)\(if $delta > $flag then " ⚠️" else "" end) |"
		end
	),
	"",
	"Median \(if $metric == $instructions then "instructions retired" else "CPU time" end) over 10 iterations. ⚠️ marks increases above \($flag)%."
'
